FORGE_WORKSPACE_ROOT=D:/workspace
FORGE_MAX_FILE_SIZE_BYTES=1000000
FORGE_MAX_TREE_ENTRIES=5000
FORGE_MAX_SEARCH_RESULTS=200
FORGE_GIT_TIMEOUT_SECONDS=10
FORGE_COMMAND_TIMEOUT_SECONDS=300

# 远程段：Provider 可选 github 或 fake（fake 不出网，用于离线演示与契约测试）
FORGE_REMOTE_PROVIDER=fake
# 只用于 GitHub REST 请求头；git push 仍使用操作者自己的凭据助手
FORGE_GITHUB_TOKEN=
FORGE_ALLOWED_REMOTE_HOSTS=["github.com"]
FORGE_ALLOWED_REPOSITORIES=[]
FORGE_REMOTE_TIMEOUT_SECONDS=30
FORGE_IDEMPOTENCY_TTL_HOURS=24

# 大模型补丁起草：provider 可选 anthropic / openai / fake（fake 仅用于离线测试，需显式 seed，不出网）
FORGE_LLM_PROVIDER=anthropic
# Anthropic Messages API key；只进请求头，不写库/审计/错误体。留空则起草接口报 MODEL_AUTH_FAILED
FORGE_ANTHROPIC_API_KEY=
FORGE_ANTHROPIC_API_URL=https://api.anthropic.com
# OpenAI（或任意 OpenAI 兼容服务）：FORGE_LLM_PROVIDER=openai 时使用，URL 含 /v1，可指向兼容服务器
FORGE_OPENAI_API_KEY=
FORGE_OPENAI_API_URL=https://api.openai.com/v1
# 起草模型，必须与所选 provider 匹配：anthropic 可设 claude-opus-5-5，openai 设对应 gpt 模型
FORGE_LLM_MODEL=claude-sonnet-5-5
FORGE_LLM_MAX_TOKENS=4096
FORGE_LLM_TIMEOUT_SECONDS=60
FORGE_LLM_MAX_CONTEXT_FILES=12
FORGE_LLM_MAX_CONTEXT_BYTES=120000
